      "label": "(5.25)",
      "name": "General LTID difference equation using delays",
      "latex": "y[n]+a_1y[n-1]+\\cdots+a_Ny[n-N]=b_0x[n]+b_1x[n-1]+\\cdots+b_Nx[n-N]",
      "sourcePage": "page-514",
