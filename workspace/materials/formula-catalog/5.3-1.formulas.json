    {
      "label": "(5.26)",
      "name": "Discrete-time transfer function polynomial ratio",
      "latex": "H[z]=\\frac{P[z]}{Q[z]}=\\frac{b_0z^N+b_1z^{N-1}+\\cdots+b_{N-1}z+b_N}{z^N+a_1z^{N-1}+\\cdots+a_{N-1}z+a_N}",
      "sourcePage": "page-515",
